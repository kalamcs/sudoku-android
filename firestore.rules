rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && validFeedback(request.resource.data);

      function validFeedback(data) {
        return data.keys().hasAll(['type', 'message', 'appVersion', 'createdAt'])
          && data.keys().hasOnly(['type', 'message', 'appVersion', 'createdAt', 'email'])
          && data.type in ['suggestion', 'bug_report', 'other']
          && data.message is string && data.message.size() <= 1000
          && data.message.matches('(?s).*[^\\s].*')
          && data.appVersion is string && data.appVersion.size() > 0 && data.appVersion.size() <= 32
          && data.createdAt == request.time
          && (!('email' in data) || (
            data.email is string && data.email.size() <= 254
            && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          ));
      }
    }
  }
}
